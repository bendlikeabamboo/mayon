# Dev image for the web SPA — runs Vite with HMR inside the container.
# node_modules and the built @mayon/shared dist are baked in; only ./src and
# ./static are bind-mounted at runtime for hot reload. Rebuild with dev:build
# after dependency, config, or shared-package changes.
# Digest pins the base layer so the dependency layers below stay cacheable
# across builds; it must move together with the Node version pin.
FROM node:22.23.4-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY server/package.json server/
# Root closure; better-sqlite3 arrives via the server dev dependency and is
# compiled from source (musl prebuilts embed a possibly unpatched musl,
# CVE-2026-107891).
RUN apk add --no-cache python3 make g++
ENV npm_config_build_from_source=true
RUN pnpm install --frozen-lockfile --filter mayon...

COPY packages/shared/ packages/shared/
RUN pnpm --filter @mayon/shared build

# Root config files Vite/SvelteKit need at dev time (src/ and static/ are
# bind-mounted for HMR; rebuild the image to pick up config changes).
COPY vite.config.ts tsconfig.json ./

EXPOSE 5173
CMD ["pnpm", "dev:vite"]
