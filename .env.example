# Mayon configuration defaults.
#
# These are read by docker compose for variable substitution. Copy to `.env`
# and adjust if needed. The server never reads this file directly — DATABASE_URL
# is always provided by the compose `environment:` block (the server reaches the
# database as `db:5432` on the internal docker network), so there is no host
# DATABASE_URL to set.

# Postgres credentials (used by both the db container and the server's DATABASE_URL).
POSTGRES_USER=mayon
POSTGRES_PASSWORD=mayon
POSTGRES_DB=mayon

# Pin a released image tag for the prod stack (e.g. 0.1.0). Defaults to `latest`.
# Used only by docker-compose.yml (prod). The dev stack builds from source.
MAYON_VERSION=latest

# Web port on the host. Change and restart to move off 8080.
MAYON_PORT=8080

# --- Optional — uncomment to use. ---

# Container engine for installer-managed installs (install.sh): docker | podman.
# Default: auto-detect (Docker preferred). The installer records its choice into
# ~/.mayon/.env; this key is read from there, not by docker compose.
# MAYON_CONTAINER_ENGINE=docker

# Opt-in telemetry delivery: secret key of your Langfuse project. Telemetry
# stays off until enabled in the app's settings, and delivery needs this key
# set on the server. (The dev stack defaults it to the langfuse-stub secret.)
# MAYON_LANGFUSE_SECRET_KEY=

# Reverse-proxy hops in front of the app, used to trust the right hop for
# client IPs. Default 1 (no proxy); the public-launch floor override below
# defaults it to 2.
# MAYON_TRUST_PROXY_HOPS=2

# --- Public-launch floor (docker-compose.override.yml.floor + Caddyfile.floor) ---
# Copy the two .floor files into the install directory (e.g. ~/.mayon/) and
# rename the override to docker-compose.override.yml — see README "Launching
# publicly (stopgap floor)". MAYON_BASIC_AUTH_USER and MAYON_BASIC_AUTH_HASH
# are REQUIRED in that mode: the stack refuses to start without them.
# Single-quote the hash — it contains `$`. Generate it with
# `docker compose run --rm caddy hash-password` (override active).
# MAYON_DOMAIN=mayon.example.com
# MAYON_BASIC_AUTH_USER=owner
# MAYON_BASIC_AUTH_HASH='$2a$14$…'
