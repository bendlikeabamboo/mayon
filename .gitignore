# Dependencies
node_modules/

# Build output
build/
.svelte-kit/
dist/
*.tsbuildinfo

# Vite
.vite/

# Drizzle generated snapshots are committed; ignore only transient artifacts
# (drizzle/ itself IS committed so migrations ship with the app)

# Environment / secrets
.env
.env.*
!.env.example
!.env.low-spec

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Testing
coverage/
test-results/
playwright-report/

# Python cache (speckit scripts)
__pycache__/
.specify/scripts/python/__pycache__/

# OPFS runtime caches

# Quarto build output + caches
docs/_book/
.quarto/
**/*.quarto_ipynb
.quarto_ipynb_checkpoints/

.playwright/
.playwright-cli/